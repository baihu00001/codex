.result-card {
  padding: 52rpx 24rpx 36rpx;
  text-align: center;
}

.success-mark {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff;
  font-size: 60rpx;
  font-weight: 800;
  line-height: 120rpx;
  box-shadow: 0 8rpx 32rpx rgba(5, 150, 105, 0.25);
  animation: successPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes successPop {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.result-title {
  color: var(--ink);
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
}

.result-subtitle {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.card {
  margin-bottom: 24rpx;
  padding: 0;
  overflow: hidden;
}

.order-cover {
  width: 100%;
  height: 300rpx;
  border-radius: 0;
  background: linear-gradient(135deg, #e8ecf2, #dde3ed);
}

.card-body {
  padding: 22rpx 24rpx 24rpx;
}

.order-title {
  margin: 0 0 18rpx;
  padding: 0 24rpx;
  padding-top: 20rpx;
  color: var(--ink);
  font-size: 33rpx;
  font-weight: 800;
  letter-spacing: -0.2rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  color: var(--ink-soft);
  font-size: 26rpx;
}

.info-row:last-child {
  border-bottom: 0;
  padding-bottom: 22rpx;
}

.info-row .price {
  font-size: 30rpx;
}

.button-primary {
  margin: 0 0 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(249, 115, 22, 0.3);
}
