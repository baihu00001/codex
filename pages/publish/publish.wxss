.page {
  padding: 20rpx 24rpx 48rpx;
}

.card {
  margin-bottom: 20rpx;
  padding: 26rpx;
}

.section-title {
  margin-bottom: 22rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border);
}

.image-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  width: 100%;
  height: 280rpx;
  border: 2rpx dashed #d1d5db;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #f9fafb, #f3f4f6);
  color: var(--muted);
  font-size: 26rpx;
  transition: border-color 0.2s, background 0.2s;
}

.image-picker:active {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.image-picker image {
  width: 100%;
  height: 100%;
}

.rich-textarea {
  height: 220rpx;
}



.button-primary {
  margin-top: 8rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(249, 115, 22, 0.3);
}

.input::placeholder,
.textarea::placeholder {
  color: #c4c4d0;
}
.field-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.insert-image-btn {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--accent);
  border-radius: 24rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.insert-image-btn::after {
  border: none;
}

.rich-image-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.rich-image-preview {
  width: 100%;
  height: 150rpx;
  border-radius: 8rpx;
  background: #f3f4f6;
}
