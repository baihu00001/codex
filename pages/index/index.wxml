<view class="page">
  <view class="hero">
    <view>
      <view class="hero-title">动态降价拍卖</view>
      <view class="hero-subtitle">举牌一次，价格随机下降一次</view>
    </view>
    <view class="hero-badge">底价保护</view>
  </view>

  <view class="toolbar">
    <view class="section-title">正在拍卖</view>
    <button class="mini-button" bindtap="goPublish">发布</button>
  </view>

  <view wx:if="{{auctions.length === 0}}" class="empty">暂无拍卖，去卖家端发布一个商品</view>

  <view
    wx:for="{{auctions}}"
    wx:key="id"
    class="auction-card"
    bindtap="goDetail"
    data-id="{{item.id}}"
  >
    <image class="cover" src="{{item.image}}" mode="aspectFill"></image>
    <view class="card-body">
      <view class="row top-row">
        <view class="title">{{item.title}}</view>
        <view class="tag {{item.status === 'sold' ? 'green' : item.status === 'ended' ? 'gray' : ''}}">{{item.statusLabel}}</view>
      </view>
      <view class="price-line">
        <text class="currency">¥</text>
        <text class="price">{{item.priceText}}</text>
      </view>
      <view class="meta">
        <text>起拍 ¥{{item.startPriceText}}</text>
        <text>底价 ¥{{item.reservePriceText}}</text>
      </view>
      <view class="stats">
        <text>{{item.participantCount}} 人参与</text>
        <text>{{item.bidCount}} 次举牌</text>
        <text>{{item.status === 'floor' ? '优先剩余' : '剩余'}} {{item.countdown}}</text>
      </view>
      <view class="seller-tag" wx:if="{{sellerName}}">{{sellerName}}</view>
    </view>
  </view>
</view>