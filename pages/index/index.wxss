.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 170rpx;
  margin-bottom: 22rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #1e293b 0%, #111827 40%, #0f172a 100%);
  color: #fff;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  right: -20rpx;
  top: -30rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(249, 115, 22, 0.3), transparent 70%);
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  position: relative;
  z-index: 1;
}

.hero-subtitle {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 24rpx;
  position: relative;
  z-index: 1;
}

.hero-badge {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #fbbf24;
  font-size: 22rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
  backdrop-filter: blur(4rpx);
}

.toolbar,
.row,
.meta,
.stats {
  display: flex;
  align-items: center;
}

.toolbar {
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.mini-button {
  width: 120rpx;
  height: 56rpx;
  margin: 0;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(249, 115, 22, 0.3);
}

.auction-card {
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  background: var(--card);
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.auction-card:active {
  transform: scale(0.985);
  box-shadow: var(--shadow);
}

.cover {
  width: 100%;
  height: 280rpx;
  background: linear-gradient(135deg, #eef2f6, #e2e8f0);
  position: relative;
}

.cover image {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 22rpx 14rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.45));
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.cover-status {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(4rpx);
}

.card-body {
  padding: 20rpx 22rpx 18rpx;
}

.top-row {
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.2rpx;
}

.price-line {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.currency {
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 700;
}

.price-line .price {
  font-size: 52rpx;
  line-height: 1;
}

.meta {
  gap: 20rpx;
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.stats {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
  color: var(--ink-soft);
  font-size: 23rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.stat-dot.hot {
  background: #f97316;
  box-shadow: 0 0 8rpx rgba(249, 115, 22, 0.4);
}

.stat-dot.warm {
  background: #f59e0b;
}

.stat-dot.cool {
  background: #94a3b8;
}
