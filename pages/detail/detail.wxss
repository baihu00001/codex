.detail-cover {
  display: block;
  width: 100%;
  height: 380rpx;
  margin-bottom: 0;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #e8ecf2, #dde3ed);
  box-shadow: var(--shadow);
}

.headline {
  padding: 24rpx 0 20rpx;
}

.title-row,
.info-row,
.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.3rpx;
}

.description {
  margin-top: 14rpx;
  color: var(--muted);
  line-height: 1.7;
  font-size: 26rpx;
}

.price-panel {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #fff7ed, #fff1e6);
  border: 1rpx solid #fed7aa;
  transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  position: relative;
  overflow: hidden;
}

.price-panel::before {
  content: "";
  position: absolute;
  right: -30rpx;
  bottom: -20rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(249, 115, 22, 0.1), transparent 70%);
}

.price-panel.pulse {
  background: linear-gradient(135deg, #ffedd5, #ffe4cc);
  transform: scale(1.02);
  box-shadow: 0 0 32rpx rgba(249, 115, 22, 0.2);
}

.price-label,
.price-range {
  color: #9a3412;
  font-size: 24rpx;
  font-weight: 600;
  position: relative;
  z-index: 1;
}

.currency {
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 700;
}

.current-price {
  color: var(--accent);
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -1rpx;
  position: relative;
  z-index: 1;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1.4fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.stat-card {
  padding: 20rpx 14rpx;
  border-radius: var(--radius-sm);
  background: #f8fafc;
  border: 1rpx solid #f1f5f9;
  text-align: center;
}

.stat-value {
  min-height: 38rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.notice {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #fed7aa;
  border-radius: var(--radius-sm);
  background: linear-gradient(135deg, #fff7ed, #fffbeb);
  color: #9a3412;
  font-size: 25rpx;
}

.action-bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.action-bar .button-primary {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
}

.action-bar .button-danger {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
}

/* 富文本详情卡片 */
.rich-card {
  margin-bottom: 20rpx;
}

.rich-content {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--ink-soft);
}

.info-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  color: var(--ink-soft);
  font-size: 25rpx;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row .label-text {
  color: var(--muted);
}

.info-row .value-text {
  color: var(--ink);
  font-weight: 600;
}

.record-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.record-row:last-child {
  border-bottom: 0;
}

.record-user {
  color: var(--ink);
  font-weight: 700;
  font-size: 26rpx;
}

.record-time {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.record-price {
  color: var(--accent);
  font-weight: 800;
  font-size: 28rpx;
}

.small {
  padding: 20rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
}
/* 卖家信息卡片 */
.seller-card {
  margin-bottom: 20rpx;
}

.seller-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.seller-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--border);
}

.seller-logo-placeholder {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seller-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.seller-desc {
  margin-bottom: 14rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.seller-contact {
  padding-top: 8rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}

.contact-label {
  color: var(--muted);
  font-size: 23rpx;
  min-width: 64rpx;
}

.contact-value {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 500;
}

.contact-phone {
  color: var(--accent);
  font-weight: 700;
}

.qr-section {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--border);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qr-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--border);
}

.qr-tip {
  color: var(--accent);
  font-size: 23rpx;
}
.rich-image {
  display: block;
  width: 100%;
  margin: 12rpx 0;
  border-radius: 8rpx;
}
