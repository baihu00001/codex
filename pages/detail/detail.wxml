<view class="page" wx:if="{{auction}}">
  <image class="detail-cover" src="{{auction.image}}" mode="aspectFill"></image>

  <view class="card headline">
    <view class="title-row">
      <view class="detail-title">{{auction.title}}</view>
      <view class="tag {{auction.status === 'sold' ? 'green' : auction.status === 'ended' ? 'gray' : ''}}">{{auction.statusLabel}}</view>
    </view>
    <view class="description">{{auction.description}}</view>

    <view class="price-panel {{pricePulse ? 'pulse' : ''}}">
      <view class="price-label">当前成交价</view>
      <view>
        <text class="currency">¥</text>
        <text class="current-price">{{auction.priceText}}</text>
      </view>
      <view class="price-range">起拍 ¥{{auction.startPriceText}} · 保底 ¥{{auction.reservePriceText}}</view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-value">{{auction.participantCount}}</view>
        <view class="stat-label">参与人数</view>
      </view>
      <view class="stat-card">
        <view class="stat-value">{{auction.bidCount}}</view>
        <view class="stat-label">举牌次数</view>
      </view>
      <view class="stat-card">
        <view class="stat-value">{{auction.countdown}}</view>
        <view class="stat-label">{{auction.status === 'floor' ? '优先剩余' : '剩余时间'}}</view>
      </view>
    </view>
  </view>

  <view class="notice" wx:if="{{auction.status === 'floor'}}">
    已触及保底价，{{auction.priorityBuyerName}} 拥有优先购买权。
  </view>

  <view class="action-bar">
    <button class="button-primary" disabled="{{bidDisabled}}" bindtap="handleBid">{{bidButtonText}}</button>
    <button class="button-danger" disabled="{{buyDisabled}}" bindtap="handleBuy">{{buyButtonText}}</button>
  </view>

  <view class="card rich-card" wx:if="{{auction.richSegments.length > 0}}">
    <view class="section-title">商品详情</view>
    <block wx:for="{{auction.richSegments}}" wx:key="index">
      <rich-text wx:if="{{item.type == 'text'}}" class="rich-content" nodes="{{item.content}}"></rich-text>
      <image wx:if="{{item.type == 'image'}}" class="rich-image" src="{{item.src}}" mode="widthFix"></image>
    </block>
  </view>

  <view class="card">
    <view class="section-title">拍卖参数</view>
    <view class="info-row">
      <text class="label-text">随机降幅</text>
      <text class="value-text">¥{{auction.minDrop}} - ¥{{auction.maxDrop}}</text>
    </view>
    <view class="info-row">
      <text class="label-text">举牌冷却</text>
      <text class="value-text">{{auction.cooldownSeconds}} 秒</text>
    </view>
    <view class="info-row">
      <text class="label-text">库存</text>
      <text class="value-text">{{auction.stock}} 件</text>
    </view>
    <view class="info-row">
      <text class="label-text">人数上限</text>
      <text class="value-text">{{auction.maxParticipants || '不限'}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{sellerProfile.auctionRules}}">
    <view class="section-title">拍卖规则</view>
    <block wx:for="{{rulesSegments}}" wx:key="index">
      <rich-text wx:if="{{item.type == 'text'}}" class="rich-content" nodes="{{item.content}}"></rich-text>
      <image wx:if="{{item.type == 'image'}}" class="rich-image" src="{{item.src}}" mode="widthFix"></image>
    </block>
    <view wx:if="{{rulesSegments.length === 0}}" class="empty small">暂无规则</view>
  </view>

  <view class="card seller-card" wx:if="{{sellerProfile.storeName}}">
    <view class="section-title">卖家信息</view>
    <view class="seller-header">
      <image wx:if="{{sellerProfile.storeLogo}}" class="seller-logo" src="{{sellerProfile.storeLogo}}" mode="aspectFill"></image>
      <view wx:else class="seller-logo-placeholder">店</view>
      <view class="seller-name">{{sellerProfile.storeName}}</view>
    </view>
    <view class="seller-desc" wx:if="{{sellerProfile.storeDescription}}">{{sellerProfile.storeDescription}}</view>
    <view class="seller-contact" wx:if="{{sellerProfile.contactPerson || sellerProfile.contactPhone || sellerProfile.contactAddress}}">
      <view class="contact-item" wx:if="{{sellerProfile.contactPerson}}">
        <text class="contact-label">联系人</text>
        <text class="contact-value">{{sellerProfile.contactPerson}}</text>
      </view>
      <view class="contact-item" wx:if="{{sellerProfile.contactPhone}}">
        <text class="contact-label">电话</text>
        <text class="contact-value contact-phone">{{sellerProfile.contactPhone}}</text>
      </view>
      <view class="contact-item" wx:if="{{sellerProfile.contactAddress}}">
        <text class="contact-label">地址</text>
        <text class="contact-value">{{sellerProfile.contactAddress}}</text>
      </view>
    </view>
    <view class="qr-section" wx:if="{{sellerProfile.wechatQR}}" bindtap="previewQR">
      <image class="qr-thumb" src="{{sellerProfile.wechatQR}}" mode="aspectFit"></image>
      <text class="qr-tip">点击查看微信二维码</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">举牌记录</view>
    <view wx:if="{{records.length === 0}}" class="empty small">暂无举牌，等你来打下第一口价</view>
    <view wx:for="{{records}}" wx:key="id" class="record-row">
      <view>
        <view class="record-user">{{item.userName}}</view>
        <view class="record-time">{{item.timeText}}</view>
      </view>
      <view class="record-price">-¥{{item.dropText}} → ¥{{item.priceText}}</view>
    </view>
  </view>
</view>
